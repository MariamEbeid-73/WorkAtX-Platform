CELERY_QUEUE=celery
SERVICE_AUTH_TOKEN=dev-service-token
AI_PROCESS_TIMEOUT_SECONDS=1800

# SUMMARIZATION SERVICE (GROQ)
# TEAM: Do NOT put your real API key in this file (it is tracked by Git).
# 1. Go to https://console.groq.com to generate a free API key.
# 2. Copy these 4 lines into your local, untracked .env file.
# 3. Replace "your_api_key_here" in your .env with your actual key.

SUMMARIZATION_PROVIDER=external
SUMMARIZATION_API_URL=https://api.groq.com/openai/v1/chat/completions
SUMMARIZATION_API_KEY=your_api_key_here
SUMMARIZATION_MODEL=llama-3.3-70b-versatile
